{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start BreakPulse Web Server",
      "type": "shell",
      "command": "node server.js",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^====================================================",
          "endsPattern": "^👉 Open in your browser"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Run Shared Gesture Vector Tests",
      "type": "shell",
      "command": "node shared-spec/run_tests.js",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Open App in Browser",
      "type": "shell",
      "command": "powershell Start-Process http://localhost:3000",
      "problemMatcher": []
    }
  ]
}
